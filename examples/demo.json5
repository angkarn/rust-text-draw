// Template used by `cargo run --example demo` to render output.png
[
  { type: "box", fill: "#e9e0d4" },

  // Title with mixed fonts and colors
  { type: "text", y: "3%", height: "10%", align: "center", valign: "middle", spans: [
      { text: "🌈 ", size: "6vw" },
      { text: "Hello ", font: "display", size: "8vw", color: "#c63658" },
      { text: "{{code}}", font: "barcode", size: "8vw" },
  ]},

  // Multilingual line: fallback picks the right font for each script
  { type: "text", y: "15%", height: "8%", text: "{{greeting}}", size: "4.5vw", align: "center", valign: "middle" },

  { type: "box", x: "30%", y: "25%", width: "40%", height: 3, fill: "#b1b2b3", radius: 2 },

  // Paragraph that shrinks to fit its box
  { type: "box", x: "5%", y: "29%", width: "90%", height: "18%", padding: "2vw", radius: "2vw",
    fill: "#ffffffaa", border: { width: 2, color: "#c9bfb0" }, children: [
      { type: "text", fit: "shrink", size: "4vw", align: "justify", spans: [
          { text: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. ", color: "#c45a5b" },
          { text: "Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book.", color: "#0c87a5" },
      ]},
  ]},

  // Alignment grid
  { type: "box", x: "5%", y: "50%", width: "90%", height: "45%", fill: "#36454f", radius: "3vw",
    padding: "3vw", color: "#ffffff", size: "3.2vw", children: [
      { type: "text", text: "left · top" },
      { type: "text", text: "center · top", align: "center" },
      { type: "text", text: "right · top", align: "right" },
      { type: "text", text: "left · middle", valign: "middle" },
      { type: "text", text: "{{name}}", size: "6vw", align: "center", valign: "middle", color: "#f39c12" },
      { type: "text", text: "right · middle", align: "right", valign: "middle" },
      { type: "text", text: "left · bottom", valign: "bottom" },
      { type: "text", text: "center · bottom", align: "center", valign: "bottom" },
      { type: "text", text: "right · bottom", align: "right", valign: "bottom" },
  ]},
]
